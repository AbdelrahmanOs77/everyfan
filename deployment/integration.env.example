# Copy to deployment/integration.env (git-ignored), fill in, then run
#   ./deployment/enable-integration.sh          (macOS / Linux / Cloud Shell)
#   ./deployment/enable-integration.ps1         (Windows)
# KEY=VALUE per line. Keys ending in _KEY, _SECRET or _CONNECTION_STRING / _CONNECTION_STR are stored as
# Container Apps secrets; everything else becomes a plain environment variable.

# ---- Pipeline: analytics (Owner B) then agents (Owner C). Never add backend.api.template_plugin here.
PIPELINE_PLUGINS=backend.analytics.plugin:register,backend.agents.plugin:register

# ---- Owner C: Foundry agents (Foundry lives in Owner C's Azure account) ---------------------------
# off = checked templates only (zero model cost, always safe) | foundry = live agents
AGENT_MODE=foundry
FOUNDRY_PROJECT_ENDPOINT=https://everyfan-ai-resource.services.ai.azure.com/api/projects/everyfan-ai
FOUNDRY_MODEL_FAST=everyfan-fast
FOUNDRY_MODEL_STRONG=everyfan-strong
# fast for both keeps the Analyst + Verifier inside the 6 s broadcast delay (measured by Owner C)
AGENT_ANALYST_MODEL_ROLE=fast
AGENT_VERIFIER_MODEL_ROLE=fast
# mcp = the Analyst calls the evidence tools over the real MCP server mounted at /mcp
AGENT_TOOLS=mcp
# The API's managed identity lives in Owner A/B's Azure account, so it cannot sign in to Owner C's
# Foundry. Owner C: Azure portal > everyfan-ai-resource > Resource Management > Keys and Endpoint > KEY 1.
FOUNDRY_API_KEY=

# ---- Owner B: Cosmos DB (optional; nothing is written when COSMOS_ENDPOINT is empty) ---------------
COSMOS_ENDPOINT=
COSMOS_DATABASE=everyfan
# Only if the API identity cannot get the data-plane role (e.g. Cosmos in a different Azure account):
COSMOS_KEY=

# ---- Cost protection -------------------------------------------------------------------------------
LIVE_MODE_DAILY_TOKEN_CAP=200000

# MCP_API_KEY is generated for you (deployment/.mcp-api-key, git-ignored) unless you set it here.
