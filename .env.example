# Copy to .env (never commit .env). Defaults shown; everything is optional for local work.

# ---- Stream ---------------------------------------------------------------
# local = in-process bus (no Azure needed); eventhubs = Azure Event Hubs
STREAM_TRANSPORT=local
# Passwordless (recommended): `az login` locally, managed identity in Azure
EVENT_HUB_NAMESPACE=everyfan-eh-xxxx.servicebus.windows.net
EVENT_HUB_NAME=match-events
# Or, for a quick first test only:
# EVENT_HUB_CONNECTION_STR=Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=...
# Only for a user-assigned managed identity (set automatically by the Bicep template)
# AZURE_CLIENT_ID=

# ---- API ------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173          # comma-separated list allowed
BROADCAST_DELAY_S=6                            # live picture delay; overlays skip it
ALLOWED_SPEEDS=1,5,10,20
# ADMIN_TOKEN=                                 # X-Admin-Token: take over or seek any broadcast
# Analytics (Owner B) then agents (Owner C). backend.api.template_plugin is Owner A's old stand-in:
# never load it together with the agents plugin (goals would air twice).
PIPELINE_PLUGINS=backend.analytics.plugin:register,backend.agents.plugin:register
PRELOAD_MATCHES=match_001
MAX_LOADED_MATCHES=2                           # ~155 MB per loaded match

# ---- Cost and abuse protection ----------------------------------------------
LIVE_MODE_DAILY_TOKEN_CAP=200000               # 0 = live AI off; the cached demo always works
RATE_LIMIT_START_PER_MIN=3
RATE_LIMIT_CONTROL_PER_MIN=30
RATE_LIMIT_READ_PER_MIN=240
MAX_WS_PER_CLIENT=6
MAX_WS_TOTAL=200
MAX_ACTIVE_LIVE_REPLAYS=2
IDLE_STOP_S=300                                # stop a live broadcast nobody watches

# ---- Owner B: analytics + Cosmos DB (optional; nothing is written when COSMOS_ENDPOINT is empty) -------
# COSMOS_ENDPOINT=https://everyfan-cosmos-xx.documents.azure.com:443/
COSMOS_DATABASE=everyfan
# Passwordless (recommended): `az login` locally, managed identity in Azure, with the
# "Cosmos DB Built-in Data Contributor" data-plane role. Only if that is impossible (e.g. different tenants):
# COSMOS_KEY=                                   # never commit; pass to Azure as a Container Apps secret
# ANALYTICS_CONFIG=backend/analytics/config.yaml

# ---- Owner C: agents --------------------------------------------------------------------------------
# off = checked templates only (no model, the safe default) | stub = offline test | foundry = live agents
AGENT_MODE=off
# FOUNDRY_PROJECT_ENDPOINT=https://everyfan-ai-resource.services.ai.azure.com/api/projects/everyfan-ai
# FOUNDRY_MODEL_FAST=everyfan-fast
# FOUNDRY_MODEL_STRONG=everyfan-strong
# Auth: Entra ID by default (`az login` locally). Cross-tenant (the API's identity is in another Azure
# account than Foundry): the Foundry resource key. Never commit it.
# FOUNDRY_API_KEY=
# FOUNDRY_OPENAI_ENDPOINT=                      # optional override, default https://<resource>.services.ai.azure.com/
AGENT_ANALYST_MODEL_ROLE=fast                   # fast keeps the Analyst inside the 6 s delay budget
AGENT_VERIFIER_MODEL_ROLE=fast
AGENT_CLUB_PERSONA=1                            # Favorite Club overlays, one per club
# inprocess = direct calls | mcp = the Analyst calls the MCP server (MCP_SERVER_URL) over Streamable HTTP
AGENT_TOOLS=inprocess
# MCP_SERVER_URL=http://127.0.0.1:8000/mcp/
# MCP_API_KEY=                                  # required for /mcp when set; same value for client and server
# MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
# Stage deadlines (seconds): AGENT_PRODUCER_TIMEOUT_S=0.5 AGENT_ANALYST_TIMEOUT_S=2.5 AGENT_WRITER_TIMEOUT_S=2
#                            AGENT_VERIFIER_TIMEOUT_S=1 AGENT_TOTAL_TIMEOUT_S=5.5
# AGENT_BUILD_CONCURRENCY=2                     # demo builds with real models: workflows at a time
# APPLICATIONINSIGHTS_CONNECTION_STRING=        # agent traces (OpenTelemetry) to Application Insights
