{
  "$defs": {
    "PlayerInfo": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "examples": [
            "nil_07"
          ],
          "title": "Player Id",
          "type": "string"
        },
        "team_id": {
          "title": "Team Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "short_name": {
          "title": "Short Name",
          "type": "string"
        },
        "name_ar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Ar"
        },
        "shirt_number": {
          "maximum": 99,
          "minimum": 1,
          "title": "Shirt Number",
          "type": "integer"
        },
        "position": {
          "enum": [
            "GK",
            "RB",
            "CB",
            "LB",
            "DM",
            "CM",
            "AM",
            "RW",
            "LW",
            "ST"
          ],
          "title": "Position",
          "type": "string"
        },
        "starter": {
          "title": "Starter",
          "type": "boolean"
        }
      },
      "required": [
        "player_id",
        "team_id",
        "name",
        "short_name",
        "shirt_number",
        "position",
        "starter"
      ],
      "title": "PlayerInfo",
      "type": "object"
    },
    "TeamInfo": {
      "additionalProperties": false,
      "properties": {
        "team_id": {
          "examples": [
            "nile_fc"
          ],
          "title": "Team Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "short_name": {
          "maxLength": 4,
          "title": "Short Name",
          "type": "string"
        },
        "name_ar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Ar"
        },
        "side": {
          "enum": [
            "home",
            "away"
          ],
          "title": "Side",
          "type": "string"
        },
        "formation": {
          "examples": [
            "4-3-3"
          ],
          "title": "Formation",
          "type": "string"
        },
        "primary_color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Primary Color",
          "type": "string"
        },
        "secondary_color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Secondary Color",
          "type": "string"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/PlayerInfo"
          },
          "title": "Players",
          "type": "array"
        }
      },
      "required": [
        "team_id",
        "name",
        "short_name",
        "side",
        "formation",
        "primary_color",
        "secondary_color",
        "players"
      ],
      "title": "TeamInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "competition": {
      "title": "Competition",
      "type": "string"
    },
    "venue": {
      "title": "Venue",
      "type": "string"
    },
    "pitch_length_m": {
      "default": 105.0,
      "title": "Pitch Length M",
      "type": "number"
    },
    "pitch_width_m": {
      "default": 68.0,
      "title": "Pitch Width M",
      "type": "number"
    },
    "period_starts_s": {
      "default": [
        0,
        2700
      ],
      "items": {
        "type": "integer"
      },
      "title": "Period Starts S",
      "type": "array"
    },
    "match_duration_s": {
      "default": 5400,
      "title": "Match Duration S",
      "type": "integer"
    },
    "home": {
      "$ref": "#/$defs/TeamInfo"
    },
    "away": {
      "$ref": "#/$defs/TeamInfo"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "match_id",
    "scenario_id",
    "seed",
    "competition",
    "venue",
    "home",
    "away"
  ],
  "title": "MatchMetadata",
  "type": "object"
}